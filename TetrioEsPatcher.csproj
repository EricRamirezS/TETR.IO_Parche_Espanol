<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>tetrio-es-patcher</AssemblyName>
    <RootNamespace>TetrioEsPatcher</RootNamespace>
    <Version>1.0.0</Version>

    <!-- El binario que se distribuye se genera con "dotnet publish" indicando un
         RID (o con ./build.ps1 / ./build.sh): produce UN ÚNICO archivo con el
         runtime .NET dentro. "dotnet build" a secas es solo para desarrollo y
         deja la carpeta bin/ con muchos DLL; esa NO es la salida final. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- Sin datos de ICU -> una dependencia menos en Linux. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- La traducción se incrusta en el ejecutable. Es SOLO el código inyectado,
         nada del código fuente de TETR.IO. -->
    <EmbeddedResource Include="Assets/translation.js" LogicalName="translation.js" />
  </ItemGroup>

</Project>
